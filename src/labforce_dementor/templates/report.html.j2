<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<title>{{ config.report.title }} — {{ data.run.target_org }}</title>
<style>
@page { size: A4; margin: 16mm 14mm 20mm; @bottom-center { content: "{{ branding.footer_text }} · Página " counter(page) " / " counter(pages); font-size: 8pt; color: #666; } }
* { box-sizing: border-box; }
body { font-family: Arial, Helvetica, sans-serif; color: #1f2937; font-size: 10pt; line-height: 1.38; }
h1,h2,h3 { color: #111827; margin: 0 0 10px; }
h1 { font-size: 28pt; } h2 { font-size: 18pt; border-bottom: 1px solid #ddd; padding-bottom: 5px; margin-top: 18px; } h3 { font-size: 13pt; margin-top: 14px; }
.cover { min-height: 245mm; display: flex; flex-direction: column; justify-content: center; page-break-after: always; }
.cover .brand { font-size: 12pt; font-weight: 700; letter-spacing: 1px; margin-bottom: 16px; }
.brand-logo { width: 92mm; max-width: 80%; height: auto; margin-bottom: 20mm; }
.cover .org { font-size: 16pt; margin: 8px 0; }
.cover .meta { color: #4b5563; margin-top: 24px; }
.score { font-size: 34pt; font-weight: 700; }
.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.card { border: 1px solid #ddd; border-radius: 8px; padding: 12px; break-inside: avoid; }
.metric { font-size: 20pt; font-weight: 700; }
.small { color: #6b7280; font-size: 8.5pt; }
table { width: 100%; border-collapse: collapse; margin: 8px 0 16px; font-size: 8.5pt; }
th, td { border: 1px solid #ddd; padding: 6px; vertical-align: top; }
th { background: #f3f4f6; text-align: left; }
.sev-critical { font-weight: 700; } .sev-high { font-weight: 700; }
img.chart { width: 100%; max-height: 125mm; object-fit: contain; }
.page-break { page-break-before: always; }
.finding { border-left: 4px solid #888; padding: 9px 12px; margin: 9px 0; break-inside: avoid; }
pre { white-space: pre-wrap; word-wrap: break-word; background: #f6f8fa; padding: 8px; font-size: 8pt; }
.document-footer { margin-top: 18mm; border-top: 1px solid #ddd; padding-top: 4mm; color: #6b7280; font-size: 8.5pt; }
</style>
</head>
<body>
<section class="cover">
  <img class="brand-logo" src="{{ branding.logo_data_uri }}" alt="Labforce">
  <div class="brand">LABFORCE DEMENTOR PARA SALESFORCE</div>
  <h1>{{ config.report.title }}</h1>
  <div class="org">{{ config.report.company_name or data.org.get('name') or data.run.target_org }}</div>
  <div class="meta">
    Organização-alvo: {{ data.run.target_org }}<br>
    Modo do assessment: {{ data.audit.get('mode') }}<br>
    Iniciado em: {{ data.run.started_at }}<br>
    Finalizado em: {{ data.run.finished_at }}<br>
    {{ config.report.confidentiality }}
  </div>
</section>

<h2>Resumo executivo</h2>
<div class="grid">
  <div class="card"><div class="small">Saúde geral</div><div class="score">{{ data.health.overall }}/100</div><div class="small">Cobertura de evidências: {{ data.health.overall_coverage_percent }}%</div></div>
  <div class="card"><div class="small">Total de achados</div><div class="metric">{{ data.findings|length }}</div><div>{{ data.health.findings_by_severity.critical }} críticos · {{ data.health.findings_by_severity.high }} altos</div></div>
</div>
{% if charts.health %}<img class="chart" src="{{ charts.health }}">{% endif %}
{% if charts.findings %}<img class="chart" src="{{ charts.findings }}">{% endif %}

<h2>Pontuação de saúde</h2>
<table><thead><tr><th>Categoria</th><th>Pontuação</th></tr></thead><tbody>
{% for k,v in data.health.categories.items() %}<tr><td>{{ data.health.category_labels.get(k, k) }}</td><td>{{ v if v is not none else 'N/D' }}</td></tr>{% endfor %}
</tbody></table>

<h2>Inventário da organização</h2>
{% if charts.inventory %}<img class="chart" src="{{ charts.inventory }}">{% endif %}
<table><thead><tr><th>Tipo de metadado</th><th>Quantidade</th></tr></thead><tbody>
{% for k,v in data.inventory.items() %}<tr><td>{{ data.inventory_labels.get(k, k) }}</td><td>{{ v }}</td></tr>{% endfor %}
</tbody></table>

<h2>Principais achados</h2>
{% for f in data.findings[:40] %}
<div class="finding sev-{{ f.severity }}">
  <strong>{{ f.id }} · {{ f.severity_label|upper }} · {{ f.title }}</strong><br>
  {% if f.component %}<span class="small">Componente: {{ f.component }}</span><br>{% endif %}
  {{ f.description }}<br>
  {% if f.recommendation %}<strong>Recomendação:</strong> {{ f.recommendation }}{% endif %}
  <div class="small">Confiança: {{ (f.confidence * 100)|round|int }}%</div>
</div>
{% endfor %}

<div class="page-break"></div>
<h2>Aplicações</h2>
<table><thead><tr><th>Aplicação</th><th>Rótulo</th><th>Abas / itens de navegação</th></tr></thead><tbody>
{% for app in data.components.applications %}<tr><td>{{ app.api_name }}</td><td>{{ app.label }}</td><td>{{ app.tabs|join(', ') }}</td></tr>{% endfor %}
</tbody></table>

<h2>Objetos e campos</h2>
{% for obj in data.components.objects %}
<h3>{{ obj.api_name }}{% if obj.label %} — {{ obj.label }}{% endif %}</h3>
<div class="small">Campos: {{ obj.fields|length }} · Tipos de registro: {{ obj.record_types|length }} · Regras de validação: {{ obj.validation_rules|length }} · Compartilhamento: {{ obj.sharing_model }}</div>
<table><thead><tr><th>Campo</th><th>Tipo</th><th>Layouts</th><th>Candidato manual</th><th>Referências de automação</th><th>Descrição</th></tr></thead><tbody>
{% for fld in obj.fields %}<tr><td>{{ fld.api_name }}</td><td>{{ fld.type }}</td><td>{{ fld.layouts|join(', ') }}</td><td>{{ 'Sim' if fld.manual_candidate else 'Não' }} ({{ (fld.manual_confidence*100)|round|int }}%)</td><td>{{ fld.references|length }}</td><td>{{ fld.description }}</td></tr>{% endfor %}
</tbody></table>
{% endfor %}

<div class="page-break"></div>
<h2>Automação</h2>
<table><thead><tr><th>Flow</th><th>Status</th><th>Objeto</th><th>Trigger</th><th>Descrição</th><th>Elementos</th></tr></thead><tbody>
{% for f in data.components.flows %}<tr><td>{{ f.api_name }}</td><td>{{ f.status }}</td><td>{{ f.object }}</td><td>{{ f.trigger_type }}</td><td>{{ f.description }}</td><td>{{ f.counts }}</td></tr>{% endfor %}
</tbody></table>

<h2>Apex</h2>
<table><thead><tr><th>Classe</th><th>Linhas</th><th>API</th><th>Teste</th><th>REST</th><th>Invocable</th><th>Callout</th></tr></thead><tbody>
{% for c in data.components.apex_classes %}<tr><td>{{ c.api_name }}</td><td>{{ c.lines }}</td><td>{{ c.api_version }}</td><td>{{ c.is_test }}</td><td>{{ c.is_rest }}</td><td>{{ c.is_invocable }}</td><td>{{ c.uses_callout }}</td></tr>{% endfor %}
</tbody></table>

<h2>Integrações</h2>
<table><thead><tr><th>Tipo</th><th>Componente</th></tr></thead><tbody>
{% for x in data.components.named_credentials %}<tr><td>Named Credential</td><td>{{ x.api_name }}</td></tr>{% endfor %}
{% for x in data.components.external_credentials %}<tr><td>External Credential</td><td>{{ x.api_name }}</td></tr>{% endfor %}
{% for x in data.components.connected_apps %}<tr><td>Connected App</td><td>{{ x.api_name }}</td></tr>{% endfor %}
{% for x in data.components.remote_sites %}<tr><td>Remote Site</td><td>{{ x.api_name }}</td></tr>{% endfor %}
</tbody></table>

<div class="page-break"></div>
<h2>Inteligência v0.2</h2>
{% set intel = data.components.get('intelligence', {}) %}
<h3>Linhagem de campos</h3>
<p>{{ intel.get('field_lineage', {}).get('field_count_with_lineage', 0) }} campos possuem evidências de linhagem de escrita/leitura. A tabela mostra os exemplos com mais evidências.</p>
<table><thead><tr><th>Campo</th><th>Gravadores</th><th>Leitores</th></tr></thead><tbody>
{% for field, lin in (intel.get('field_lineage', {}).get('fields', {})).items() %}{% if loop.index <= 250 %}<tr><td>{{ field }}</td><td>{% for x in lin.writers %}{{ x.component }} ({{ (x.confidence*100)|round|int }}%){% if not loop.last %}<br>{% endif %}{% endfor %}</td><td>{% for x in lin.readers %}{{ x.component }} ({{ (x.confidence*100)|round|int }}%){% if not loop.last %}<br>{% endif %}{% endfor %}</td></tr>{% endif %}{% endfor %}
</tbody></table>

<h3>Cobertura Apex</h3>
{% if charts.apex_coverage %}<img class="chart" src="{{ charts.apex_coverage }}">{% endif %}
{% set cov = intel.get('apex_coverage', {}) %}
<p>Disponível: {{ 'Sim' if cov.get('available', false) else 'Não' }} · Cobertura agregada: {{ cov.get('overall_percent', 'N/D') }}{% if cov.get('overall_percent') is not none %}%{% endif %}</p>
<table><thead><tr><th>Componente</th><th>Cobertas</th><th>Não cobertas</th><th>Cobertura</th></tr></thead><tbody>
{% for x in cov.get('components', [])[:100] %}<tr><td>{{ x.name }}</td><td>{{ x.covered }}</td><td>{{ x.uncovered }}</td><td>{{ x.coverage_percent if x.coverage_percent is not none else 'N/D' }}{% if x.coverage_percent is not none %}%{% endif %}</td></tr>{% endfor %}
</tbody></table>

<h3>Inteligência de permissões efetivas</h3>
{% set ep = intel.get('effective_permissions', {}) %}
<p>Usuários ativos analisados: {{ ep.get('active_users_analyzed', 0) }} · Usuários privilegiados detectados: {{ ep.get('privileged_users', [])|length }}</p>
<table><thead><tr><th>Usuário</th><th>Permissões críticas do sistema</th><th>Objetos com Modify All</th></tr></thead><tbody>
{% for u in ep.get('privileged_users', [])[:100] %}<tr><td>{{ u.username }}</td><td>{{ u.critical_user_permissions|join(', ') }}</td><td>{{ u.objects_modify_all|join(', ') }}</td></tr>{% endfor %}
</tbody></table>

<h3>Volume de dados</h3>
{% if charts.data_volume %}<img class="chart" src="{{ charts.data_volume }}">{% endif %}
{% set dp = intel.get('data_profile', {}) %}
<p>Objetos contabilizados: {{ dp.get('objects_counted', 0) }} · Candidatos a LDV: {{ dp.get('ldv_candidates', [])|length }}</p>
<table><thead><tr><th>Objeto</th><th>Registros estimados</th></tr></thead><tbody>
{% for x in dp.get('largest_objects', [])[:50] %}<tr><td>{{ x.object }}</td><td>{{ x.record_count }}</td></tr>{% endfor %}
</tbody></table>

<h3>Pontos críticos da ordem de execução</h3>
{% if charts.automation_hotspots %}<img class="chart" src="{{ charts.automation_hotspots }}">{% endif %}
<table><thead><tr><th>Objeto</th><th>Componentes</th><th>Antes de salvar</th><th>Após salvar</th><th>Triggers</th><th>Regras de validação</th></tr></thead><tbody>
{% for x in intel.get('order_of_execution', {}).get('hotspots', [])[:100] %}<tr><td>{{ x.object }}</td><td>{{ x.automation_components }}</td><td>{{ x.before_save_flows|join(', ') }}</td><td>{{ x.after_save_flows|join(', ') }}</td><td>{{ x.triggers|join(', ') }}</td><td>{{ x.validation_rules|join(', ') }}</td></tr>{% endfor %}
</tbody></table>

<h3>Raio de impacto</h3>
<table><thead><tr><th>Componente</th><th>Dependências diretas</th><th>Alcance em dois saltos</th><th>Pontuação</th></tr></thead><tbody>
{% for x in intel.get('blast_radius', {}).get('top_components', [])[:100] %}<tr><td>{{ x.component }}</td><td>{{ x.direct_dependencies }}</td><td>{{ x.two_hop_reach }}</td><td>{{ x.blast_radius_score }}</td></tr>{% endfor %}
</tbody></table>

<h3>Execução / observabilidade</h3>
<pre>{{ intel.get('runtime_usage', {}) | tojson(indent=2) }}</pre>
<h3>Lacunas de evidências</h3>
<p>{{ intel.get('evidence_gaps', [])|join(', ') if intel.get('evidence_gaps') else 'Nenhuma detectada pelos coletores de execução v0.2.' }}</p>

<div class="page-break"></div>
<h2>Inteligência da organização v0.3</h2>
{% set v3 = intel.get('v3', {}) %}
<h3>Risco de mudança e dívida técnica</h3>
{% if charts.change_risk %}<img class="chart" src="{{ charts.change_risk }}">{% endif %}
<table><thead><tr><th>Componente</th><th>Grau de dependência</th><th>Penalidade dos achados</th><th>Risco de mudança</th><th>Dívida técnica</th></tr></thead><tbody>
{% for x in v3.get('risk_and_debt', {}).get('top_change_risk', [])[:100] %}<tr><td>{{ x.component }}</td><td>{{ x.dependency_degree }}</td><td>{{ x.finding_penalty }}</td><td>{{ x.change_risk_score }}</td><td>{{ x.technical_debt_score }}</td></tr>{% endfor %}
</tbody></table>

<h3>Evidências de execução de aplicações e APIs</h3>
{% if charts.app_usage %}<img class="chart" src="{{ charts.app_usage }}">{% endif %}
{% set ev = v3.get('event_monitoring', {}) %}
<p>Corpos dos logs de eventos disponíveis: {{ 'Sim' if ev.get('available', false) else 'Não' }} · Evidências de usuários ativos: {{ ev.get('active_users_evidence', 0) }}</p>
<table><thead><tr><th>Aplicação observada</th><th>Eventos</th></tr></thead><tbody>{% for x in ev.get('app_usage', [])[:100] %}<tr><td>{{ x.app }}</td><td>{{ x.events }}</td></tr>{% endfor %}</tbody></table>
<table><thead><tr><th>Evidência de cliente de API / Connected App</th><th>Eventos</th></tr></thead><tbody>{% for x in ev.get('api_clients', [])[:100] %}<tr><td>{{ x.client }}</td><td>{{ x.events }}</td></tr>{% endfor %}</tbody></table>

<h3>Perfil de qualidade dos dados (opcional)</h3>
{% set dq = v3.get('data_quality_profile', {}) %}
<p>Ativado: {{ 'Sim' if dq.get('enabled', false) else 'Não' }} · Objetos analisados: {{ dq.get('objects_profiled', 0) }} · Valores brutos persistidos: {{ 'Sim' if dq.get('raw_values_persisted', false) else 'Não' }}</p>
{% for o in dq.get('objects', []) %}{% if not o.get('unavailable') %}<h4>{{ o.object }}</h4><table><thead><tr><th>Campo</th><th>Linhas da amostra</th><th>Nulos %</th><th>Valores distintos</th><th>Proporção distinta %</th></tr></thead><tbody>{% for f in o.field_stats %}<tr><td>{{ f.field }}</td><td>{{ f.sampled_rows }}</td><td>{{ f.null_percent }}</td><td>{{ f.distinct_count_sample }}</td><td>{{ f.distinct_ratio_percent }}</td></tr>{% endfor %}</tbody></table>{% endif %}{% endfor %}

<h3>Mapa semântico de Apex e integrações</h3>
<table><thead><tr><th>Classe</th><th>Tipo de endpoint</th><th>Mapeamento de URL</th></tr></thead><tbody>{% for x in v3.get('apex_semantic_map', {}).get('endpoints', []) %}<tr><td>{{ x.class }}</td><td>{{ x.type }}</td><td>{{ x.url_mapping or '' }}</td></tr>{% endfor %}</tbody></table>
<table><thead><tr><th>Classe</th><th>Endpoint de callout</th></tr></thead><tbody>{% for x in v3.get('apex_semantic_map', {}).get('callouts', []) %}<tr><td>{{ x.class }}</td><td>{{ x.endpoint }}</td></tr>{% endfor %}</tbody></table>

<h3>Mapa de caminhos de Flow</h3>
<table><thead><tr><th>Flow</th><th>Elementos</th><th>Destinos dos conectores</th><th>Subflows</th><th>Ações</th></tr></thead><tbody>{% for name,x in v3.get('flow_path_map', {}).get('flows', {}).items() %}<tr><td>{{ name }}</td><td>{{ x.element_names|length }}</td><td>{{ x.connector_targets|length }}</td><td>{{ x.subflows|join(', ') }}</td><td>{{ x.actions|join(', ') }}</td></tr>{% endfor %}</tbody></table>

<h3>Dependências de relatórios e painéis</h3>
<pre>{{ v3.get('report_dashboard_dependencies', {}) | tojson(indent=2) }}</pre>


<div class="page-break"></div>
<h2>Grafo empresarial e inteligência de acesso v1.0</h2>
{% set v4 = intel.get('v4', {}) %}

<h3>Mapa estrutural de Apex</h3>
<p>Parser: {{ v4.get('apex_ast', {}).get('parser', 'N/D') }} · Componentes mapeados: {{ v4.get('apex_ast', {}).get('components_mapped', 0) }}</p>
<table><thead><tr><th>Componente</th><th>Referências Apex</th><th>Objetos SOQL</th></tr></thead><tbody>
{% for x in v4.get('apex_ast', {}).get('components', [])[:150] %}
<tr><td>{{ x.component }}</td><td>{{ x.apex_references|join(', ') }}</td><td>{{ x.soql_objects|join(', ') }}</td></tr>
{% endfor %}
</tbody></table>

<h3>Grafo estrutural de Flow</h3>
<p>Flows mapeados estruturalmente: {{ v4.get('flow_structural', {}).get('flows_mapped', 0) }}</p>
<table><thead><tr><th>Flow</th><th>Elementos</th><th>Arestas</th></tr></thead><tbody>
{% for name,x in v4.get('flow_structural', {}).get('flows', {}).items() %}
<tr><td>{{ name }}</td><td>{{ x.elements|length }}</td><td>{{ x.edge_count }}</td></tr>
{% endfor %}
</tbody></table>

<h3>Linhagem da interface</h3>
<p>Arquivos de interface analisados: {{ v4.get('ui_lineage', {}).get('files_scanned', 0) }} · Relações de dependência adicionadas: {{ v4.get('ui_lineage', {}).get('edges_added', 0) }}</p>

<h3>Evidências de acesso efetivo</h3>
<p>Usuários analisados: {{ v4.get('effective_access', {}).get('users_analyzed', 0) }}</p>
<table><thead><tr><th>ID do usuário</th><th>Conjuntos de permissões</th><th>Permissões críticas</th><th>Objetos com Modify All</th><th>Campos editáveis</th></tr></thead><tbody>
{% for u in v4.get('effective_access', {}).get('users', [])[:150] %}
<tr><td>{{ u.user_id }}</td><td>{{ u.permission_sets|join(', ') }}</td><td>{{ u.critical_user_permissions|join(', ') }}</td><td>{{ u.object_modify_all|join(', ') }}</td><td>{{ u.editable_fields_count }}</td></tr>
{% endfor %}
</tbody></table>

<h3>Modelo de compartilhamento</h3>
<table><thead><tr><th>Objeto</th><th>OWD interno</th><th>OWD externo</th></tr></thead><tbody>
{% for x in v4.get('sharing', {}).get('objects', []) %}
<tr><td>{{ x.object }}</td><td>{{ x.internal_owd or 'N/A' }}</td><td>{{ x.external_owd or 'N/A' }}</td></tr>
{% endfor %}
</tbody></table>

<h3>Linhagem de pacotes e namespaces</h3>
<pre>{{ v4.get('package_lineage', {}) | tojson(indent=2) }}</pre>

<div class="page-break"></div>
<h2>Manifesto de segurança do assessment</h2>
<table><tbody>
<tr><th>Modo</th><td>{{ data.audit.get('mode', '') }}</td></tr>
<tr><th>Organização alterada</th><td>NÃO</td></tr>
<tr><th>DML executado</th><td>0</td></tr>
<tr><th>Implantações de metadados</th><td>0</td></tr>
<tr><th>Execuções de Apex Anonymous</th><td>0</td></tr>
<tr><th>Operações de leitura executadas</th><td>{{ data.audit.get('read_operations', 0) }}</td></tr>
<tr><th>Recuperação de metadados</th><td>{{ 'Sim' if data.audit.get('metadata_retrieve_executed', false) else 'Não' }}</td></tr>
<tr><th>Code Analyzer</th><td>{{ data.code_analyzer.get('available', false) }}</td></tr>
</tbody></table>

<h3>Orçamento de API</h3>
<pre>{{ data.audit.get('api_budget', {}) | tojson(indent=2) }}</pre>

<h3>Erros de leitura / fontes indisponíveis</h3>
<pre>{{ data.audit.get('read_errors', []) | tojson(indent=2) }}</pre>

<h3>Comandos executados</h3>
<pre>{% for cmd in data.audit.get('commands', []) %}{{ cmd }}\n{% endfor %}</pre>

<h2>Evidências de dependências</h2>
<table><thead><tr><th>Origem</th><th>Relação</th><th>Destino</th><th>Confiança</th></tr></thead><tbody>
{% for d in data.dependencies[:1000] %}<tr><td>{{ d.source }}</td><td>{{ d.relationship }}</td><td>{{ d.target }}</td><td>{{ (d.confidence*100)|round|int }}%</td></tr>{% endfor %}
</tbody></table>

{% set ent = data.components.get('intelligence', {}).get('enterprise', {}) %}
{% if ent %}
<h2>Núcleo de inteligência empresarial</h2>
{% set twin = ent.get('digital_twin', {}) %}
<div class="grid">
  <div class="card"><div class="small">Gêmeo digital</div><div class="metric">{{ twin.get('nodes',0) }}</div><div>{{ twin.get('edges',0) }} relações normalizadas</div></div>
  <div class="card"><div class="small">Ciclos de automação</div><div class="metric">{{ twin.get('automation_cycles',[])|length }}</div><div>ciclos fortemente conectados</div></div>
  <div class="card"><div class="small">Prontidão das capacidades</div><div class="metric">{{ ent.get('competitive_readiness',{}).get('overall_readiness_percent','N/D') }}%</div><div>prontidão interna baseada em evidências</div></div>
  <div class="card"><div class="small">Cobertura de evidências</div><div class="metric">{{ ent.get('evidence_quality',{}).get('evidence_coverage_percent','N/D') }}%</div><div>achados com evidências</div></div>
</div>
<h3>Principais pontos críticos estruturais</h3>
<table><thead><tr><th>Componente</th><th>Tipo</th><th>Grau</th><th>Criticidade</th></tr></thead><tbody>
{% for row in twin.get('hotspots',[])[:20] %}<tr><td><code>{{ row.component }}</code></td><td>{{ row.node_type }}</td><td>{{ row.degree }}</td><td>{{ row.structural_criticality_score }}</td></tr>{% endfor %}
</tbody></table>
<h3>Plano de remediação</h3>
<table><thead><tr><th>Prioridade</th><th>Severidade</th><th>Componente</th><th>Achado</th><th>Pontuação</th></tr></thead><tbody>
{% for row in ent.get('remediation_plan',{}).get('items',[])[:30] %}<tr><td><b>{{ row.priority }}</b></td><td>{{ data.rotulos.severidades.get(row.severity, row.severity) }}</td><td><code>{{ row.component }}</code></td><td>{{ row.title }}</td><td>{{ row.remediation_priority_score }}</td></tr>{% endfor %}
</tbody></table>
<h3>Orientador de arquitetura</h3>
{% for rec in ent.get('architecture_advisor',{}).get('recommendations',[]) %}<div class="finding"><b>{{ rec.priority }} · {{ rec.title }}</b><div>{{ rec.rationale }}</div></div>{% endfor %}
{% endif %}
{% set v7 = data.components.get('intelligence', {}).get('v7', {}) %}
{% if v7 %}
<h2>Camada final de inteligência</h2>
{% set fr = v7.get('final_readiness', {}) %}
<div class="grid">
  <div class="card"><div class="small">Prontidão do produto</div><div class="metric">{{ fr.get('readiness_percent','N/D') }}%</div><div>{{ fr.get('engine_status_label', fr.get('engine_status','')) }}</div></div>
  <div class="card"><div class="small">Análise de Flows</div><div class="metric">{{ v7.get('flow_quality',{}).get('flows_analyzed',0) }}</div><div>Flows inspecionados em profundidade</div></div>
  <div class="card"><div class="small">Risco de execução</div><div class="metric">{{ v7.get('runtime_health',{}).get('runtime_risk_score','N/D') }}</div><div>pontuação baseada em evidências</div></div>
  <div class="card"><div class="small">Risco de integração</div><div class="metric">{{ v7.get('integration_health',{}).get('health_risk_score','N/D') }}</div><div>postura de endpoints e credenciais</div></div>
</div>
<h3>Candidatos a colisão transacional</h3>
<table><thead><tr><th>Objeto</th><th>Pontuação de colisão</th><th>Atores que alteram dados</th></tr></thead><tbody>
{% for row in v7.get('order_of_execution_graph',{}).get('collision_candidates',[])[:25] %}<tr><td><code>{{ row.object }}</code></td><td>{{ row.collision_score }}</td><td>{{ row.mutating_actors }}</td></tr>{% endfor %}
</tbody></table>
<h3>Saúde da execução</h3><pre>{{ v7.get('runtime_health',{}).get('signals',{}) | tojson(indent=2) }}</pre>
<h3>Saúde dos dados</h3>
<table><thead><tr><th>Objeto</th><th>Registros</th><th>Risco</th><th>Média de nulos %</th><th>Concentração</th></tr></thead><tbody>
{% for row in v7.get('data_health',{}).get('highest_risk_objects',[])[:25] %}<tr><td><code>{{ row.object }}</code></td><td>{{ row.record_count }}</td><td>{{ row.data_health_risk_score }}</td><td>{{ row.average_null_percent_sample }}</td><td>{{ row.ownership_skew_candidate }}</td></tr>{% endfor %}
</tbody></table>
{% endif %}
<footer class="document-footer">{{ branding.footer_text }}</footer>
</body>
</html>
